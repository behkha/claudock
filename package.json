{
  "name": "claudock",
  "productName": "Claudock",
  "version": "0.1.1",
  "description": "Unofficial desktop manager for the Claude Code config folder (~/.claude)",
  "homepage": "https://github.com/behkha/claudock",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/behkha/claudock.git"
  },
  "bugs": "https://github.com/behkha/claudock/issues",
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "electron",
    "settings",
    "mcp",
    "skills",
    "hooks"
  ],
  "desktopName": "claudock.desktop",
  "main": "out/main/index.js",
  "bin": {
    "claudock": "bin/claudock.js"
  },
  "files": [
    "bin/",
    "out/",
    "resources/"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "author": "Claudock",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:real": "electron-vite dev",
    "build": "electron-vite build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON \"src/**/*.test.ts\"",
    "fixture": "node scripts/make-fixture.mjs",
    "fixture:hooks": "node scripts/fixture-hooks.mjs",
    "fixture:status": "node scripts/fixture-status.mjs",
    "shot": "node scripts/shot.mjs",
    "icons": "electron scripts/make-icons.mjs",
    "settings-docs": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/make-settings-docs.mjs",
    "dist:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@eslint/js": "^10.0.1",
    "@lezer/highlight": "^1.2.5",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "diff": "^9.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lucide-react": "^1.61.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "electron": "^45.0.0"
  }
}
